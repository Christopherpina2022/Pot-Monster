<Window x:Class="FGC_Stat_Analyzer_wpf.Views.ChildWindows.helpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf.Views.ChildWindows"
        mc:Ignorable="d"
        Title="What is Pot Monster?" Height="300" Width="1020">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        <!-- About -->
        <TextBlock Grid.Row="0" FontWeight="Bold" FontStyle="Italic" Text="Pot Monster" FontSize="16" Margin="10,0,0,0"/>
        <TextBlock Grid.Row="1" FontSize="14" Margin="20,0,0,0">
            <Run Text="A person that enters tournaments knowing they will lose early." />
            <LineBreak />
            <Run Text="It can act as either a harsh insult, or a reminder that the statistics do not make the FGC;" />
            <LineBreak />
            <Run Text="it's the people who keep coming back no matter how many"/>
            <Run x:Name="punchLine" />
        </TextBlock>
        
        <!-- Instructions -->
        <TextBlock Grid.Row="2" FontWeight="Bold" FontStyle="Italic" Text="Instructions" FontSize="16" Margin="10, 0, 0, 0"/>
        <TextBlock Grid.Row="3" FontSize="14" Margin="20, 0, 0, 0">
            Fill in the left sidebar your Tournament of choice along with it's state code and any optional parameters then hit 'submit'.
            <LineBreak />
            <Run FontStyle="Italic" Text="Do note that this app only supports US Tournaments (for now)." />
            <LineBreak />
            <Run FontWeight="Bold" Text="Types of queries:" />
            <LineBreak />
            <Run FontWeight="Bold" FontStyle="Italic" Text="Top 8:" />
            <Run Text="How many times a user was in a top 8 position and what positions" />
            <LineBreak />
            <Run FontWeight="Bold" FontStyle="Italic" Text="Attendee Headcount:" />
            <Run Text="How many times an attendee has entered a tournament series. no date time params will lookup every result it can find" />
            <LineBreak />
            <Run FontWeight="Bold" FontStyle="Italic" Text="Get Attendee Info:" />
            <Run Text="Searches the latest tournament attendee info to gather user Stream handle specific data (Name, Pronouns, etc)" />
        </TextBlock>
    </Grid>
</Window>
