<UserControl x:Class="FGC_Stat_Analyzer_wpf.Views.UserControls.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="30">
        <Menu VerticalAlignment="Center" Margin="10,0,10,0" Background="Transparent">
            <MenuItem x:Name="helpMenu" Header="Help" FontSize="16" Click="helpMenu_Click"/>
            <MenuItem Header="Profile" FontSize="16">
                <MenuItem x:Name="apiMenu" Header="Setup API Key" Click="apiMenu_Click"/>
                <MenuItem x:Name="createMenu" Header="Make New Profile" />
                <MenuItem x:Name="importMenu" Header="Import Profile"/>
            </MenuItem>
            <MenuItem Header="Table" FontSize="16">
                <MenuItem Header="Export as..." />
            </MenuItem>
        </Menu>
    </Grid>
    
</UserControl>
