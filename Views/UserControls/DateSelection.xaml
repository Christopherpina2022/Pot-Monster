<UserControl x:Class="FGC_Stat_Analyzer_wpf.Views.UserControls.DateSelection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <DatePicker x:Name="dateSelector" Grid.Column="1" Focusable="False" SelectedDateChanged="dateSelector_SelectedDateChanged" VerticalContentAlignment="Center"/>
        <Label x:Name="dateLabel" Grid.Column="0" Margin="20, 0, 0, 0" Focusable="False" Content="{Binding DateLabelPlaceholder}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
