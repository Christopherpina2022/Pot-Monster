<UserControl x:Class="FGC_Stat_Analyzer_wpf.Views.UserControls.DateSelection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <DatePicker x:Name="dateSelector" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="125" Focusable="False" SelectedDateChanged="dateSelector_SelectedDateChanged"/>
        <Label x:Name="dateLabel" FontWeight="Bold" Grid.Column="0" FontSize="13" Margin="10, 0, 0, 0" VerticalAlignment="Center" Focusable="False" Content="{Binding DateLabelPlaceholder}" />
    </Grid>
</UserControl>
