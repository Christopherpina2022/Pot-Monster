<UserControl x:Class="FGC_Stat_Analyzer_wpf.Views.UserControls.ResultsDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>
        
        <!-- Upper banner-->
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*" />
                <ColumnDefinition Width="60*" />
            </Grid.ColumnDefinitions>

            <!-- Combobox -->
            <ComboBox x:Name="filterCombo" Width="240" Height="30" HorizontalAlignment="Left" Focusable="False" SelectionChanged="filterCombo_SelectionChanged" Margin="10"/>
            <!-- Banner -->
            <Image x:Name="tournamentBanner" Grid.Column ="1" Source="{Binding imageURL}" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center" >
                <!-- Feathered edge at the left -->
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0.8" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
        </Grid>

        <!-- Data table -->
        <DataGrid x:Name="resultsTable" Grid.Row="1" Focusable="False" IsReadOnly="True" HorizontalGridLinesBrush="#FFE0E0E0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" AlternationCount="2">
            <!-- Column Header style -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#f0b181"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#4a2203"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                    
                    <Setter Property="Background" Value="#e37622"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="BorderBrush" Value="#FF404040"/>
                </Style>
                
            </DataGrid.ColumnHeaderStyle>

            <!-- Rows -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">

                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#FF202020"/>

                    <Style.Triggers>
                        <!-- Alternating rows -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                            <Setter Property="Background" Value="#f7e6d5"/>
                        </DataTrigger>

                        <!-- Mouse hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#f0b181"/>
                        </Trigger>

                        <!-- Selected row -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#4a2203"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>

                    </Style.Triggers>

                </Style>
            </DataGrid.RowStyle>
            
            <!-- Cell style -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter Margin="3,5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>
</UserControl>
