<UserControl x:Class="FGC_Stat_Analyzer_wpf.Views.UserControls.ResultsDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <Grid Background="{DynamicResource BannerBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>
        
        <!-- Upper banner-->
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <GroupBox Grid.Column="0" Padding="10" Margin="10">
                <GroupBox.Header>
                    <Label>Data Filters and Exporting</Label>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Game Category filter -->
                    <Label Grid.Row="0" FontSize="15">Videogame Category</Label>
                    <ComboBox x:Name="filterCombo" Grid.Row="1" Focusable="False" SelectionChanged="filterCombo_SelectionChanged"/>

                    <!-- Export Button -->
                    <Button x:Name="exportButton" Height="30" Width="150" Grid.Row="3" HorizontalAlignment="Right" IsEnabled="False" Margin="10" Content="Export as..." />
                </Grid>
            </GroupBox>
            
            <!-- Banner -->
            <Image x:Name="tournamentBanner" Grid.Column ="1" Source="{Binding imageURL}" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center" >
                <!-- Feathered edge at the left -->
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0.8" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
        </Grid>

        <!-- Data table -->
        <DataGrid x:Name="resultsTable" Grid.Row="1" Focusable="False" IsReadOnly="True" HorizontalGridLinesBrush="#FFE0E0E0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" 
                  AlternationCount="2">
            <!-- Column Header style -->
            <DataGrid.ColumnHeaderStyle>
                <StaticResource ResourceKey="ResultsTableHeaderStyle"/>
            </DataGrid.ColumnHeaderStyle>

            <!-- Rows -->
            <DataGrid.RowStyle>
                <StaticResource ResourceKey="ResultsTableRowStyle"/>
            </DataGrid.RowStyle>

            <!-- Cell style -->
            <DataGrid.CellStyle>
                <StaticResource ResourceKey="ResultsTableCellStyle"/>
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>
</UserControl>
