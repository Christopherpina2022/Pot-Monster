<UserControl x:Class="FGC_Stat_Analyzer_wpf.Views.UserControls.ResultsDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>
        <ComboBox x:Name="filterCombo" Width="240" Margin="10,0,0,0" Height="30" HorizontalAlignment="Left" VerticalContentAlignment="Center" Focusable="False" SelectionChanged="filterCombo_SelectionChanged"/>
        <DataGrid x:Name="resultsTable" Grid.Row="1" AlternatingRowBackground="AntiqueWhite" Focusable="False" IsReadOnly="True">
            
        </DataGrid>
    </Grid>
</UserControl>
