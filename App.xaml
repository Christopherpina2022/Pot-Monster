<Application x:Class="FGC_Stat_Analyzer_wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="PixArial">/Fonts/#Pixel Arial 11</FontFamily>
            <FontFamily x:Key="FiraCode">/Fonts/#Fira Code</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ColorPaletteDictionary.xaml"/>
                <ResourceDictionary Source="/Styles/DataGridDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
