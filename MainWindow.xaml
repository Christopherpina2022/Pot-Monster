<Window x:Class="FGC_Stat_Analyzer_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf"
        xmlns:UserControls="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35*"/>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <!-- Header Background -->
        <Border Grid.Row="0" Background="DarkRed" Panel.ZIndex="-1" Grid.ColumnSpan="3"/>

        <!-- Midpoint Background -->
        <Border Grid.Row="1" Background="IndianRed" Panel.ZIndex="-1" Grid.ColumnSpan="3"/>

        <!-- Footer Background -->
        <Border Grid.Row="2" Background="DarkRed" Panel.ZIndex="-1" Grid.ColumnSpan="3"/>

        <!-- Sidebar -->
        <UserControls:Sidebar Grid.Row="1"/>
    </Grid>
</Window>
