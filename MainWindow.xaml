<Window x:Class="FGC_Stat_Analyzer_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FGC_Stat_Analyzer_wpf"
        xmlns:UserControls="clr-namespace:FGC_Stat_Analyzer_wpf.Views.UserControls"
        mc:Ignorable="d"
        Title="Pot Monster" Height="1000" Width="1500"
        FontFamily="{StaticResource PixArial}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="65*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="Gray" Panel.ZIndex="-1" Grid.ColumnSpan="2"/>
        <UserControls:HeaderBar Grid.Row="0" Grid.ColumnSpan="2"/>

        <!-- Midpoint -->
        <Border Grid.Row="1" Background="LightGray" Panel.ZIndex="-1" Grid.ColumnSpan="2"/>
        <UserControls:Sidebar x:Name="sidebar" Grid.Row="1" Background="LightGray"/>
        <UserControls:ResultsDataGrid x:Name="resultsDataGrid" Grid.Row="1" Grid.Column="1" />

        <!-- Footer -->
        <Border Grid.Row="2" Background="DarkGray" Grid.ColumnSpan="2"/>
    </Grid>

</Window>