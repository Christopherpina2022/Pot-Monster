<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Main Window items -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#8a9697" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#657475"/>
    <SolidColorBrush x:Key="BannerBrush" Color="#b6bebe"/>
    <!-- DataGrid Headers -->
    <SolidColorBrush x:Key="DataHeaderDefaultBrush" Color="#403114"/>
    <SolidColorBrush x:Key="DataHeaderForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="DataHeaderBorderBrush" Color="#FF404040"/>
    <SolidColorBrush x:Key="DataHeaderHoverBrush" Color="#4a4c44"/>
    <!-- DataTable Clicked Brushes -->
    <SolidColorBrush x:Key="DataTableClickedBrush" Color="#4a2203"/>
    <SolidColorBrush x:Key="DataTableClickedForegroundBrush" Color="White"/>
    <!-- DataGrid Rows -->
    <SolidColorBrush x:Key="DataRowDefaultBrush" Color="#89806c"/>
    <SolidColorBrush x:Key="DataRowForegroundBrush" Color="#f0f3f3"/>
    <SolidColorBrush x:Key="DataRowAlternatingBrush" Color="#aca38d"/>
    <SolidColorBrush x:Key="DataRowHoverBrush" Color="#6f6247"/>
</ResourceDictionary>