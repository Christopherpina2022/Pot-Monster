<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Main Window items -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#5e5036" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#229589"/>
    <SolidColorBrush x:Key="BannerBrush" Color="#eaad7c"/>
    <!-- DataGrid Headers -->
    <SolidColorBrush x:Key="DataHeaderDefaultBrush" Color="#e92b18"/>
    <SolidColorBrush x:Key="DataHeaderForegroundBrush" Color="Black"/>
    <SolidColorBrush x:Key="DataHeaderBorderBrush" Color="#942313"/>
    <SolidColorBrush x:Key="DataHeaderHoverBrush" Color="#5169a3"/>
    <!-- DataTable Clicked Brushes -->
    <SolidColorBrush x:Key="DataTableClickedBrush" Color="#4c3928"/>
    <SolidColorBrush x:Key="DataTableClickedForegroundBrush" Color="White"/>
    <!-- DataGrid Rows -->
    <SolidColorBrush x:Key="DataRowDefaultBrush" Color="#edb384"/>
    <SolidColorBrush x:Key="DataRowForegroundBrush" Color="Black"/>
    <SolidColorBrush x:Key="DataRowAlternatingBrush" Color="#616c99"/>
    <SolidColorBrush x:Key="DataRowHoverBrush" Color="#f0b181"/>
</ResourceDictionary>