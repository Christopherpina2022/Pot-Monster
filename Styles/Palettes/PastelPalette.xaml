<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Main Window items -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#cdb4db" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#ffafcc"/>
    <SolidColorBrush x:Key="BannerBrush" Color="#ffc8dd"/>
    <!-- DataGrid Headers -->
    <SolidColorBrush x:Key="DataHeaderDefaultBrush" Color="#a2d2ff"/>
    <SolidColorBrush x:Key="DataHeaderForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="DataHeaderBorderBrush" Color="#FF404040"/>
    <SolidColorBrush x:Key="DataHeaderHoverBrush" Color="#bde0fe"/>
    <!-- DataTable Clicked Brushes -->
    <SolidColorBrush x:Key="DataTableClickedBrush" Color="#349afa"/>
    <SolidColorBrush x:Key="DataTableClickedForegroundBrush" Color="White"/>
    <!-- DataGrid Rows -->
    <SolidColorBrush x:Key="DataRowDefaultBrush" Color="White"/>
    <SolidColorBrush x:Key="DataRowForegroundBrush" Color="Black"/>
    <SolidColorBrush x:Key="DataRowAlternatingBrush" Color="#c5e1fa"/>
    <SolidColorBrush x:Key="DataRowHoverBrush" Color="#bde0fe"/>
</ResourceDictionary>