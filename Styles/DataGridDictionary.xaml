<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Headers -->
    <Style x:Key="ResultsTableHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource DataHeaderDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataHeaderForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource DataHeaderBorderBrush}"/>

        <Style.Triggers>
            <!-- Mouse hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataHeaderHoverBrush}"/>
            </Trigger>
            
            <!-- Selected header -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataTableClickedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataTableClickedForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Rows -->
    <Style x:Key="ResultsTableRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource DataRowDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataRowForegroundBrush}"/>

        <Style.Triggers>
            <!-- Alternating rows -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                <Setter Property="Background" Value="{DynamicResource DataRowAlternatingBrush}"/>
            </DataTrigger>

            <!-- Mouse hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataRowHoverBrush}"/>
            </Trigger>

            <!-- Selected row -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataTableClickedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataTableClickedForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Cells -->
    <Style x:Key="ResultsTableCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="3,5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>